{
  "name": "@factory/portal-site",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run worker:build && vite",
    "build": "bun run worker:build && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "echo 'no linter configured yet'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
