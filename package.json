{
  "name": "agent-software-factory",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "cli": "bun run packages/cli/src/index.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --filter=@factory/api",
    "docker:up": "docker compose up --build -d",
    "docker:heartbeat": "docker compose ps && curl -fsS http://localhost:3001/health && docker compose exec -T postgres pg_isready -U \"${POSTGRES_USER:-factory}\"",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
