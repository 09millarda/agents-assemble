DATABASE_URL=postgresql://agents_assemble:local-development-only@127.0.0.1:55433/agents_assemble
PORT=3001
WEB_ORIGIN=http://localhost:5173
DEPLOYMENT_ID=local-agents-assemble
STATE_DIRECTORY=.local/control-plane
# Run npm run bootstrap interactively to create the initial local admin.
# GitHub credentials belong to the integration adapter only.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# Optional hosted AuthKit adapter: configure all three together.
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_REDIRECT_URI=http://localhost:5173/
# OIDC audience must match the repository-owned release workflow.
# GITHUB_OIDC_AUDIENCE=agents-assemble
# RUNNER_HOSTNAME=localhost
# Hosted publication defaults to invitation-only. Local installations may opt in.
# PUBLICATION_POLICY=invitation
# INVITED_PUBLISHER_ORGANIZATIONS=organization-uuid,another-organization-uuid
